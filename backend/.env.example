# Configuración general
NODE_ENV=development
JWT_SECRET=cambiar_este_secreto

# Superadmin Janus (login /admin). Generar hash:
# node -e "require('bcrypt').hash('tu-clave', 12).then(console.log)"
JANUS_SUPERADMIN_USER=janus
JANUS_SUPERADMIN_PASSWORD_HASH=
# Orígenes extra para CORS (coma-separados). Útil si el front no entra por la regla de red local.
# Ej: http://192.168.1.110:5173
# CORS_ORIGINS=
PORT=3000

# Configuración de la base de datos maestra
EMPRESAS_DB_NAME=janus314_master
EMPRESAS_DB_USER=root
EMPRESAS_DB_PASSWORD=your_password_here
EMPRESAS_DB_HOST=localhost

# Configuración del pool de conexiones
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Cloudinary (galería de remitos: listado en ingreso por remito)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta para listar imágenes en ingreso por remito (Admin API). La subida móvil usa remitos/{empresaId} del JWT.
CLOUDINARY_REMITOS_PREFIX=remitos/empresa

# Export automático informe Rubros por Provincia (contador / Drive)
# Preferí configurar desde la UI: /configuracion/reportes (t_configuracion).
# Estos env son fallback / filtro opcional del cron:
# CONTADOR_EMPRESA_ID=uuid-de-la-empresa
# CONTADOR_REPORTS_DIR=/var/janus/contador/rubros-provincia
# CONTADOR_RCLONE_REMOTE=gdrive:Contabilidad/RubrosProvincia
